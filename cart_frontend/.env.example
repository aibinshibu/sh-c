# Copy this file to .env and fill it in. Never share the real .env file.
BACKEND_URL=http://localhost:8000
# must match the backend's API_KEY
API_KEY=change_me_to_a_long_random_string

ADMIN_PASSWORD=choose_a_strong_admin_password

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Display name at the top of the sidebar (useful to distinguish multiple carts)
CART_NAME=Cart 1
