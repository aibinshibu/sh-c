# Copy this file to .env and fill it in. Never share the real .env file.
GOOGLE_API_KEY=your_google_api_key

# Shared secret: the frontend must send the same value in its own .env
API_KEY=change_me_to_a_long_random_string

# OpenVINO model (best.xml); best.bin and metadata.yaml must sit next to it
MODEL_PATH=models/best.xml

# Concurrency limit (maximum videos analysed simultaneously)
MAX_CONCURRENT_VIDEOS=2

# Optional CPU thread limit per model instance (defaults to max(1, cpu_count // MAX_CONCURRENT_VIDEOS))
# MODEL_THREADS=2
